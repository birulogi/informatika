<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>LKPD Informatika - Eksplorasi Kodular</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        @media print {
            .no-print { display: none; }
            body { background-color: white; padding: 0; }
            .container { box-shadow: none; margin: 0; width: 100%; max-width: 100%; border: none; }
            textarea, select, input { border: 1px solid #ccc !important; }
        }
        th, td { min-width: 120px; }
        .table-responsive { overflow-x: auto; -webkit-overflow-scrolling: touch; }
    </style>
</head>
<body class="bg-blue-900 min-h-screen p-2 md:p-4 font-sans text-gray-800">

    <div class="max-w-4xl mx-auto bg-white rounded-xl shadow-2xl overflow-hidden container">
        
        <header class="bg-blue-800 text-white p-5 md:p-6 text-center">
            <h1 class="text-xl md:text-2xl font-bold uppercase tracking-wide">Lembar Kerja Peserta Didik</h1>
            <p class="text-sm opacity-90">Materi: Mengenal Komponen Dasar & Logika Button Kodular</p>
        </header>

        <main class="p-4 md:p-6 space-y-6">
            
            <section class="bg-yellow-50 border-l-4 border-yellow-400 p-4 rounded shadow-sm">
                <h2 class="text-yellow-800 font-bold text-sm uppercase mb-2">Instruksi Tugas:</h2>
                <p class="text-xs text-yellow-900 leading-relaxed">
                    Selamat datang di bengkel aplikasi! Tugas hari ini adalah memahami alat-alat (komponen) di Kodular dan mempraktikkan cara kerja tombol sederhana. Gunakan bantuan Google untuk mengisi tabel, lalu tonton video tutorial untuk praktik langsung!
                </p>
            </section>

            <section class="space-y-4 bg-blue-50 p-4 rounded-lg border border-blue-100 shadow-sm">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-bold text-blue-900 mb-1">Pilih Kelas:</label>
                        <select id="kelas_pd" class="w-full border-2 border-blue-200 rounded-lg p-2 text-sm outline-none focus:border-blue-600 bg-white font-semibold transition-all">
                            <option value="">-- Pilih Kelas --</option>
                            <option value="11-1">11 - 1</option>
                            <option value="11-2">11 - 2</option>
                            <option value="11-5">11 - 5</option>
                            <option value="11-6">11 - 6</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-blue-900 mb-1">Kelompok (Maks. 6):</label>
                        <select id="kelompok_pd" class="w-full border-2 border-blue-200 rounded-lg p-2 text-sm outline-none focus:border-blue-600 bg-white font-semibold transition-all">
                            <option value="">-- Pilih Kelompok --</option>
                            <script>for(let i=1;i<=6;i++) document.write(`<option value="Kelompok ${i}">Kelompok ${i}</option>`);</script>
                        </select>
                    </div>
                </div>

                <div class="pt-2">
                    <label class="block text-[10px] font-bold text-blue-800 uppercase mb-2">Daftar Anggota (Maks. 7 Orang):</label>
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2">
                        <script>
                            for(let i=1; i<=7; i++) {
                                document.write(`
                                <div class="flex items-center gap-2 bg-white p-1 rounded border border-blue-100">
                                    <span class="text-[10px] font-bold text-blue-700 w-3">${i}</span>
                                    <input type="text" id="agt_${i}" placeholder="Nama Lengkap" class="w-full p-1 text-xs outline-none bg-transparent">
                                </div>
                                `);
                            }
                        </script>
                    </div>
                </div>
            </section>

            <section class="space-y-3">
                <h2 class="text-blue-900 font-bold text-xs md:text-sm uppercase italic">Tugas 1: Deskripsi & Fungsi Komponen</h2>
                <p class="text-[10px] text-gray-500 italic">Tips: Cari di Google dengan kata kunci "Fungsi komponen [Nama Komponen] di Kodular"</p>
                <div class="table-responsive border rounded-lg">
                    <table class="w-full border-collapse text-xs md:text-sm">
                        <thead>
                            <tr class="bg-gray-100 text-blue-900 border-b text-center font-bold">
                                <th class="p-2 border-r w-1/3">Komponen</th>
                                <th class="p-2">Kegunaan / Fungsi Utama</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-200">
                            <script>
                                const comps = ["Button", "Label", "TextBox", "Image", "Notifier", "Horizontal Arrangement", "Vertical Arrangement", "Space", "CheckBox", "List View"];
                                comps.forEach((c, index) => {
                                    document.write(`
                                    <tr>
                                        <td class="p-3 font-bold text-blue-800 bg-gray-50 border-r text-center">${c}</td>
                                        <td class="p-2"><textarea id="f_${index+1}" class="w-full border rounded p-1.5 h-12 outline-none text-[11px]" placeholder="Ketik fungsinya di sini..."></textarea></td>
                                    </tr>
                                    `);
                                });
                            </script>
                        </tbody>
                    </table>
                </div>
            </section>

            <section class="space-y-4">
                <h2 class="text-sm font-bold text-blue-800 border-l-4 border-blue-800 pl-2 uppercase">Tugas 2: Praktik Sesuai Contoh Video</h2>
                <div class="p-4 border rounded-lg bg-blue-50 space-y-4">
                    <p class="text-xs font-bold">Tonton video tutorial ini untuk membuat aplikasi "Tampilkan Pesan" sederhana:</p>
                    
                    <div class="bg-white p-3 rounded border border-blue-200 flex items-center gap-3">
                        <div class="bg-red-600 text-white p-2 rounded text-[10px] font-bold">YouTube</div>
                        <a href="https://youtu.be/z1V1G08-wGw?list=PLS4aD2mIBBiKKgnhWgpAeRJvZ9S6gAaxV" target="_blank" class="text-blue-700 font-bold text-xs underline decoration-blue-400">Tutorial Menggunakan Button & Notifier di Kodular</a>
                    </div>

                    <ol class="list-decimal list-inside text-xs space-y-2 text-gray-700 pt-2">
                        <li>Buat proyek baru di Kodular.</li>
                        <li>Ganti warna latar belakang (Background Color) menjadi <b>Biru</b>.</li>
                        <li>Ikuti langkah di video untuk memasang <b>Button</b> dan <b>Notifier</b>.</li>
                        <li>Pastikan saat tombol diklik, muncul pesan: <b>"Halo, kami dari [Nama Kelompok] sedang belajar Kodular!"</b></li>
                    </ol>

                    <div class="mt-4">
                        <label class="block text-xs font-bold mb-2">Hasil Refleksi Praktik:</label>
                        <textarea id="refleksi" class="w-full border p-2 rounded h-20 text-xs outline-none focus:ring-1 focus:ring-blue-400" placeholder="Apa yang terjadi saat kalian menekan tombol? Berhasilkah notifikasinya muncul?"></textarea>
                    </div>
                </div>
            </section>

            <section class="flex flex-wrap gap-4 justify-center pt-4 no-print">
                <button onclick="simpanLokal()" class="bg-green-600 hover:bg-green-700 text-white font-bold py-3 px-8 rounded-full shadow-lg transition-all active:scale-95 text-sm">
                    Simpan Progres
                </button>
                <button onclick="window.print()" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-8 rounded-full shadow-lg transition-all active:scale-95 text-sm">
                    Cetak / Simpan PDF
                </button>
            </section>
        </main>

        <footer class="bg-gray-100 text-center p-4 text-[10px] text-gray-500 border-t">
            &copy; 2026 Informatika SMA - Semua Hak Dilindungi.
        </footer>
    </div>

    <script>
        function simpanLokal() {
            const data = {
                kelas: document.getElementById('kelas_pd').value,
                kelompok: document.getElementById('kelompok_pd').value,
                agt: Array.from({length: 7}, (_, i) => document.getElementById(`agt_${i+1}`).value),
                fungsi: Array.from({length: 10}, (_, i) => document.getElementById(`f_${i+1}`).value),
                refleksi: document.getElementById('refleksi').value
            };
            localStorage.setItem('lkpd_kodular_final_v4', JSON.stringify(data));
            Swal.fire({ 
                icon: 'success', 
                title: 'Berhasil Disimpan!', 
                text: 'Pekerjaan kelompok kalian tersimpan di memori browser.', 
                confirmButtonColor: '#1e40af' 
            });
        }

        window.onload = () => {
            const s = JSON.parse(localStorage.getItem('lkpd_kodular_final_v4'));
            if (s) {
                document.getElementById('kelas_pd').value = s.kelas || '';
                document.getElementById('kelompok_pd').value = s.kelompok || '';
                s.agt.forEach((v, i) => { if(document.getElementById(`agt_${i+1}`)) document.getElementById(`agt_${i+1}`).value = v || '' });
                s.fungsi.forEach((v, i) => { if(document.getElementById(`f_${i+1}`)) document.getElementById(`f_${i+1}`).value = v || '' });
                document.getElementById('refleksi').value = s.refleksi || '';
            }
        };
    </script>
</body>
</html>
